; Copy this file to Project/export_presets.cfg before exporting.
; Project/export_presets.cfg is intentionally ignored by git.

[preset.0]

name="Android Release"
platform="Android"
runnable=true
dedicated_server=false
custom_features=""
export_filter="all_resources"
include_filter=""
exclude_filter=""
export_path="build/android/ProjectReignition.apk"
patch_list=Array[Dictionary]([])

[preset.0.options]

custom_template/debug=""
custom_template/release=""
gradle_build/use_gradle_build=false
architectures/armeabi-v7a=false
architectures/arm64-v8a=true
architectures/x86=false
architectures/x86_64=false
package/unique_name="com.projectreignition.game"
package/name="Project Reignition"
package/version="1.0.8"
package/signed=false
package/app_category=0
package/retain_data_on_uninstall=false
package/exclude_from_recents=false
screen/immersive_mode=true
screen/orientation=1
permissions/internet=false
permissions/access_network_state=false
permissions/vibrate=false

[preset.0.options.permissions]

INTERNET=false
ACCESS_NETWORK_STATE=false
VIBRATE=false
